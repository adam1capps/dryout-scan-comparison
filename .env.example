# Clerk — from dashboard.clerk.com > API keys.
# Use the existing re-dry.com production instance: any subdomain of re-dry.com
# shares its session cookie automatically, so no per-job Clerk setup is needed.
# The publishable key is compiled into the client bundle; the secret key is
# read only by Netlify Functions and must never be prefixed with VITE_.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Who may edit reports. Comma-separated, case-insensitive. A Clerk session
# proves identity, not permission — the instance is shared with the rest of
# re-dry.com, so without this list any signed-in user on the domain could
# edit. Unset means nobody can edit: misconfiguration locks the reports
# rather than opening them. Becomes the global super-admin list once per-job
# editor lists land (PLAN.md Phase 2). Per-job editors are set in Job setup;
# this list is the global super-admin one, and it also gates the cross-job
# screens (the jobs registry and the export).
REPORT_EDITORS=adam@re-dry.com

# SendGrid — used by quote requests and change orders. Create a key with only
# the Mail Send permission. The from-address must be a verified sender in
# SendGrid; with re-dry.com domain authentication any @re-dry.com address
# works and DKIM aligns for DMARC.
SENDGRID_API_KEY=SG.xxx

# Backups (tools/backup.mjs) read the authenticated export, so they need a
# signed-in editor's Clerk session token. Never stored on the site — passed on
# the command line at run time:
#   BACKUP_TOKEN=eyJ... npm run backup
# BACKUP_SITE and BACKUP_DIR override the platform URL and output folder.

# NETLIFY_DB_URL is injected automatically by @netlify/database in builds,
# functions and `netlify dev`. Do not set it by hand.
